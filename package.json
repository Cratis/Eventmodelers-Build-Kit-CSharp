{
  "name": "@cratis/eventmodelers-build-kit-csharp",
  "version": "0.0.1",
  "description": "Real-time Claude agent that connects to the Eventmodelers Platform and implements board slices as Cratis (Arc + Chronicle) vertical slices in a .NET / C# project",
  "type": "module",
  "bin": "src/cli.js",
  "scripts": {
    "prepublishOnly": "chmod +x src/cli.js",
    "build": "echo 'Build complete'",
    "test": "yarn node --test tests/*.test.js",
    "test:coverage": "yarn node --test --experimental-test-coverage tests/*.test.js",
    "lint": "yarn eslint .",
    "lint:ci": "yarn eslint . --quiet"
  },
  "files": [
    "src",
    "templates",
    "tests",
    "Documentation",
    "README.md"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "eventmodelers",
    "cratis",
    "chronicle",
    "event-sourcing",
    "dotnet",
    "csharp",
    "slice-changed",
    "realtime-agent"
  ],
  "author": "Cratis",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "commander": "^12.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^7.0.2"
  }
}
